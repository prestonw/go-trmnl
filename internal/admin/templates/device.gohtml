{{define "content"}}
{{$d := .Device}}
<p><a href="/admin/devices">&larr; Devices</a></p>
<h1>{{def $d.FriendlyID (ns $d.Name)}}</h1>

<div class="split">
  <div>
    <h2>Telemetry</h2>
    <table class="kv">
      <tr><th>Friendly ID</th><td>{{$d.FriendlyID}}</td></tr>
      <tr><th>MAC</th><td><code>{{$d.MAC}}</code></td></tr>
      <tr><th>API key</th><td><code>{{$d.APIKey}}</code></td></tr>
      <tr><th>Model</th><td>{{def "&mdash;" (ns $d.Model)}}</td></tr>
      <tr><th>Firmware</th><td>{{def "&mdash;" (ns $d.FWVersion)}}</td></tr>
      <tr><th>Resolution</th><td>{{$d.Width}}&times;{{$d.Height}}</td></tr>
      <tr><th>Battery</th><td>{{with nf $d.BatteryVoltage 2}}{{.}}V{{else}}&mdash;{{end}}</td></tr>
      <tr><th>RSSI</th><td>{{def "&mdash;" (ni $d.RSSI)}}</td></tr>
      <tr><th>Last seen</th><td>{{since $d.LastSeenAt}}</td></tr>
    </table>
  </div>
  <div>
    <h2>Current screen</h2>
    {{if .PreviewHash}}
      <img class="preview" src="{{.BaseURL}}/uploads/{{.PreviewHash}}.png" alt="current screen">
    {{else}}
      <p class="muted">Nothing rendered yet.</p>
    {{end}}
    <form method="post" action="/admin/devices/{{$d.ID}}/refresh">
      <button type="submit">Force refresh</button>
    </form>
  </div>
</div>

<h2>Settings</h2>
<form method="post" action="/admin/devices/{{$d.ID}}">
  <label>Name <input type="text" name="name" value="{{ns $d.Name}}"></label>
  <label>Base refresh rate (s) <input type="number" name="refresh_rate" min="5" value="{{$d.RefreshRate}}"></label>
  <p class="muted" style="margin-top: 0; font-size: 0.9em;">How often the device polls for the next screen. A screen set to a live cadence in the Screens editor overrides this while it is showing.</p>
  <label>Panel width <input type="number" name="width" min="0" value="{{$d.Width}}"></label>
  <label>Panel height <input type="number" name="height" min="0" value="{{$d.Height}}"></label>
  <p class="muted" style="margin-top: 0; font-size: 0.9em;">Screens render at this size. Leave blank to keep the last reported value; the standard TRMNL panel is 800&times;480.</p>
  <label>Playlist
    <select name="playlist_id">
      <option value="0">(none)</option>
      {{range .Playlists}}
        <option value="{{.ID}}" {{if and $d.PlaylistID.Valid (eq $d.PlaylistID.Int64 .ID)}}selected{{end}}>{{.Name}}</option>
      {{end}}
    </select>
  </label>
  <label>Font bundle
    <select name="font_bundle">
      <option value="classic" {{if eq $d.FontBundle "classic"}}selected{{end}}>Classic (BlockKie, NicoBold, dogicapixel)</option>
      <option value="trmnl" {{if eq $d.FontBundle "trmnl"}}selected{{end}}>TRMNL (Hand-made pixel fonts)</option>
    </select>
    <p class="muted" style="margin-top: 0; font-size: 0.9em;">Bundles use assets from <code>data/uploads/assets/bundles/</code>. Global font overrides in Settings take precedence.</p>
  </label>
  <label>
    <input type="checkbox" name="show_battery" value="1" {{if $d.ShowBattery}}checked{{end}}>
    Battery indicator in the screen footer
    <p class="muted" style="margin-top: 0; font-size: 0.9em;">Draws a four-step battery symbol in the bottom right of every screen this device shows. It changes only when the level changes, so cached images and e-ink refreshes are unaffected.</p>
  </label>
  <label>
    <input type="checkbox" name="color_enabled" value="1" {{if $d.ColorEnabled}}checked{{end}}>
    Color mode (24-bit BMP)
    <p class="muted" style="margin-top: 0; font-size: 0.9em;">Renders screens as full-color 24-bit BMPs for TFT LCD panels. Leave off for standard 1-bit e-ink TRMNL panels.</p>
  </label>
  <label>Special function
    {{$fn := def "none" (ns $d.SpecialFunction)}}
    <select name="special_function">
      {{range $opt := slice "none" "identify" "sleep" "add_wifi" "restart_playlist" "rewind" "send_to_me"}}
        <option value="{{$opt}}" {{if eq $fn $opt}}selected{{end}}>{{$opt}}</option>
      {{end}}
    </select>
  </label>
  <button type="submit">Save</button>
</form>

<h2>Firmware</h2>
<p class="muted">Current version: {{def "&mdash;" (ns $d.FWVersion)}}</p>
{{if $d.FirmwareUpdate}}
  <p>Update <strong>pending</strong>{{if $d.FirmwareURL.Valid}} from <code>{{ns $d.FirmwareURL}}</code>{{end}}, delivered on the next poll.</p>
  <form method="post" action="/admin/devices/{{$d.ID}}/firmware/cancel">
    <button type="submit">Cancel pending update</button>
  </form>
{{else}}
  <form method="post" action="/admin/devices/{{$d.ID}}/firmware">
    <label>Firmware URL (.bin) <input type="text" name="firmware_url" placeholder="https://.../firmware.bin"></label>
    <button type="submit">Queue OTA update</button>
  </form>
{{end}}

<h2>Inkplate Controls</h2>
<p class="muted">Device-specific rendering controls pushed on every /api/display poll. The device reads these and adjusts behavior immediately on next poll.</p>
<form method="post" action="/admin/devices/{{$d.ID}}/inkplate-config">
  <label>Partial refresh zone
    <input type="text" name="partial_refresh_zone" id="partial_refresh_zone" placeholder="x,y,w,h" value="{{inkplateField "partial_refresh_zone" "" .InkplateConfig}}">
    <p class="muted">Zone to redraw with partial refresh, e.g. "24,58,376,104"</p>
  </label>
  <label>Wake button GPIO
    <select name="wake_button_gpio">
      {{range $opt := slice "none" "36" "35" "34" "33"}}
        <option value="{{$opt}}" {{if hasInkplateField "wake_button_gpio" $opt .InkplateConfig}}selected{{end}}>{{$opt}}</option>
      {{end}}
    </select>
    <p class="muted">GPIO pin for wake button. GPIO36 = default Inkplate6 wake pin.</p>
  </label>
  <label>Background fill
    <select name="bg_fill">
      {{range $opt := slice "white" "gray" "off"}}
        <option value="{{$opt}}" {{if hasInkplateField "bg_fill" $opt .InkplateConfig}}selected{{end}}>{{$opt}}</option>
      {{end}}
    </select>
    <p class="muted">Full white wipe before redraw to prevent ghosting.</p>
  </label>
  <label>Full refresh interval (seconds)
    <input type="number" name="full_refresh_interval" min="0" value="{{inkplateField "full_refresh_interval" "0" .InkplateConfig}}">
    <p class="muted">0 = disabled. When set, device does full refresh every N seconds.</p>
  </label>
  <label>Bold text
    <select name="bold_text">
      {{range $opt := slice "auto" "on" "off"}}
        <option value="{{$opt}}" {{if hasInkplateField "bold_text" $opt .InkplateConfig}}selected{{end}}>{{$opt}}</option>
      {{end}}
    </select>
    <p class="muted">Auto = server-side bold. On = device doubles ink.</p>
  </label>
  <label>Time display format
    <select name="time_format">
      {{range $opt := slice "digits" "words" "both"}}
        <option value="{{$opt}}" {{if hasInkplateField "time_format" $opt .InkplateConfig}}selected{{end}}>{{$opt}}</option>
      {{end}}
    </select>
    <p class="muted">Words = "Ten", "Fifty Nine" stacked. Digits = traditional.</p>
  </label>
  <label>Location position
    <select name="location_position">
      {{range $opt := slice "below_time" "above_weather" "hidden"}}
        <option value="{{$opt}}" {{if hasInkplateField "location_position" $opt .InkplateConfig}}selected{{end}}>{{$opt}}</option>
      {{end}}
    </select>
    <p class="muted">Where to draw the location name.</p>
  </label>
  <button type="submit">Save config</button>
</form>

<p>
  <a href="/admin/devices/{{$d.ID}}/logs">View logs</a>
</p>

<form method="post" action="/admin/devices/{{$d.ID}}/delete" onsubmit="return confirm('Delete this device?')">
  <button type="submit" class="danger">Delete device</button>
</form>
{{end}}
