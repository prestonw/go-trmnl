{{define "content"}}
{{$s := .Screen}}
<p><a href="/admin/screens">&larr; Screens</a></p>
<h1>{{$s.Name}} <span class="muted">({{.PluginType}})</span></h1>

<div class="split">
  <div>
    <h2>Settings</h2>
    <form method="post" action="/admin/screens/{{$s.ID}}">
      <label>Name <input type="text" name="name" value="{{$s.Name}}"></label>
      <label>Dithering mode
        <select name="dither_mode">
          <option value="" {{if eq .DitherMode ""}}selected{{end}}>Default (global: {{.GlobalDither}})</option>
          <option value="floyd_steinberg" {{if eq .DitherMode "floyd_steinberg"}}selected{{end}}>Floyd-Steinberg (best for photos)</option>
          <option value="threshold" {{if eq .DitherMode "threshold"}}selected{{end}}>Threshold (sharp, for text/UI)</option>
        </select>
      </label>
      <label>Refresh cadence
        <select name="refresh_seconds">
          <option value="" {{if eq .RefreshSeconds 0}}selected{{end}}>Default (plugin rate)</option>
          <option value="5" {{if eq .RefreshSeconds 5}}selected{{end}}>Live — every 5 seconds</option>
          <option value="10" {{if eq .RefreshSeconds 10}}selected{{end}}>Live — every 10 seconds</option>
          <option value="15" {{if eq .RefreshSeconds 15}}selected{{end}}>Live — every 15 seconds</option>
          <option value="30" {{if eq .RefreshSeconds 30}}selected{{end}}>Live — every 30 seconds</option>
        </select>
      </label>
      <p class="muted" style="margin-top: 0; font-size: 0.9em;">Live screens are dashboards: while one is showing, the device holds on it and re-renders at this cadence instead of cycling the playlist — good for clock/weather on always-powered panels. Leave at Default for normal rotation.</p>
      {{if .IsFamilyCalendar}}
      <p>Calendar accounts to show <span class="muted">(none selected = all)</span></p>
      {{range .FCAccounts}}
      <label class="check"><input type="checkbox" name="accounts" value="{{.ID}}" {{if .Selected}}checked{{end}}> {{.Name}} <span class="muted">({{.Provider}}{{if .Marker}}, {{.Marker}}{{end}})</span></label>
      {{else}}
      <p class="muted">No calendar accounts yet — add them under <a href="/admin/calendar">Calendar</a>.</p>
      {{end}}
      <label>Days ahead <input type="number" name="days" value="{{.FCDays}}" min="1" step="1"></label>
      <label>Max events <input type="number" name="max_events" value="{{.FCMaxEvents}}" min="1" step="1"></label>
      <label>Label <input type="text" name="label" value="{{.FCLabel}}"></label>
      <label class="check"><input type="checkbox" name="use_24h" {{if .FCUse24h}}checked{{end}}> 24-hour times</label>

      <h3>Weather</h3>
      <label>Location name <input type="text" name="location" value="{{.FCLocation}}" placeholder="e.g. Karlsruhe"></label>
      <label>Latitude <input type="number" name="latitude" value="{{.FCLatitude}}" step="any"></label>
      <label>Longitude <input type="number" name="longitude" value="{{.FCLongitude}}" step="any"></label>
      <label>Units
        <select name="units">
          <option value="metric" {{if eq .FCUnits "metric"}}selected{{end}}>Metric (°C, km/h)</option>
          <option value="imperial" {{if eq .FCUnits "imperial"}}selected{{end}}>Imperial (°F, mph)</option>
        </select>
      </label>
      {{else if .IsWeather}}
      <h3>Location</h3>
      <label>Location name <input type="text" name="wc_location" value="{{.WCLocation}}" placeholder="e.g. Dublin"></label>
      <label>Latitude <input type="number" name="wc_latitude" value="{{.WCLatitude}}" step="any"></label>
      <label>Longitude <input type="number" name="wc_longitude" value="{{.WCLongitude}}" step="any"></label>
      <label>Units
        <select name="wc_units">
          <option value="metric" {{if eq .WCUnits "metric"}}selected{{end}}>Metric (°C, km/h)</option>
          <option value="imperial" {{if eq .WCUnits "imperial"}}selected{{end}}>Imperial (°F, mph)</option>
        </select>
      </label>
      <label>Label <input type="text" name="wc_label" value="{{.WCLabel}}" placeholder="optional corner label"></label>
      <label>Timezone <input type="text" name="wc_timezone" value="{{.WCTimezone}}" placeholder="e.g. Europe/Dublin (empty = server local)"></label>

      <h3>Clock</h3>
      <label class="check"><input type="checkbox" name="wc_draw_clock" {{if .WCDrawClock}}checked{{end}}> Device draws the clock locally (server leaves the time card blank)</label>
      <p class="muted" style="font-size: 0.9em;">When enabled the weather screen's time card is rendered without a time — the device draws the clock from its own RTC and ticks it forward each minute with a partial e-paper pulse (radio off by default). When disabled the server bakes the current time into the image on each render.</p>
      <label class="check"><input type="checkbox" name="wc_use_24h" {{if .WCUse24h}}checked{{end}}> 24-hour time</label>
      <label>Partial refresh interval (seconds) <input type="number" name="wc_partial_refresh" value="{{.WCPartialRefresh}}" min="60" max="3600" step="60"></label>
      <p class="muted" style="font-size: 0.9em;">Whole minutes between local ticks (60–3600, step 60). Each wake redraws only the time digits with a partial update; the radio stays off.</p>
      <label class="check"><input type="checkbox" name="wc_partial_refresh_wifi" {{if .WCPartialRefreshWiFi}}checked{{end}}> Enable Wi-Fi on partial refresh wakes <span class="muted">(off by default; for live data like tickers / MQTT)</span></label>
      {{else}}
      <label>Settings (JSON)
        <textarea name="settings_json" rows="10">{{$s.SettingsJSON}}</textarea>
      </label>
      {{end}}
      <button type="submit">Save</button>
    </form>

    {{if .IsImage}}
    <h2>Upload image</h2>
    <form method="post" action="/admin/screens/{{$s.ID}}/upload" enctype="multipart/form-data">
      <input type="file" name="image" accept="image/*">
      <button type="submit">Upload</button>
    </form>
    {{end}}
  </div>
  <div>
    <h2>Preview</h2>
    {{if .PreviewHash}}
      <img class="preview" src="{{.BaseURL}}/uploads/{{.PreviewHash}}.png" alt="preview">
    {{else if $s.RenderedHash.Valid}}
      <img class="preview" src="{{.BaseURL}}/uploads/{{ns $s.RenderedHash}}.png" alt="preview">
    {{else}}
      <p class="muted">Not rendered yet.</p>
    {{end}}
    <form method="post" action="/admin/screens/{{$s.ID}}/preview">
      <label>Preview with device/bundle
        <select name="device_id">
          <option value="">Default (Go fonts)</option>
          {{range $.Devices}}
            <option value="{{.ID}}">{{.Name}} ({{.FontBundle}})</option>
          {{end}}
        </select>
      </label>
      <button type="submit">Render preview</button>
      <p class="muted" style="font-size: 0.9em; margin-top: 0.5em;">Choose a device to see how its selected <strong>font bundle</strong> affects this screen.</p>
    </form>
  </div>
</div>

<form method="post" action="/admin/screens/{{$s.ID}}/delete" onsubmit="return confirm('Delete this screen?')">
  <button type="submit" class="danger">Delete screen</button>
</form>
{{end}}
